alias fuck="__pr_main suggest"

function __pr_main() {
	eval $(__pr_base "$1" "$(fc -ln -1)")
}

function __pr_base() {
	prefix=$(print -P "$PROMPT")
	_PR_MODE="$1" _PR_PREFIX="$prefix" _PR_LAST_COMMAND="$2" _PR_ALIAS="`alias`" _PR_SHELL="zsh" "/home/jakubgargul/.cargo/bin/pay-respects"
}

function __pr_inline() {
	local input="$BUFFER"
	local output=$(__pr_base "inline" "$input")

	
	if [[ -n "$output" ]]; then
		BUFFER="$output"
		CURSOR=${#BUFFER}
	fi
	
}

zle -N __pr_inline
bindkey '^X^X' __pr_inline
command_not_found_handler() {
	eval $(__pr_base "cnf" "$*")
}


